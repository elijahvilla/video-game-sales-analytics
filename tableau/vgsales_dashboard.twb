<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='2025.1.0 (20251.25.0101.0000)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
<document-format-change-manifest />
<preferences>
  <color-palette name='Lands Between Gold' type='ordered-sequential'><color>#221D16</color><color>#3F3420</color><color>#64511F</color><color>#8E6F22</color></color-palette>
  <color-palette name='Game Regions' type='regular'><color>#2E6FDB</color><color>#FFCB05</color><color>#E52521</color><color>#3FA34D</color></color-palette><color-palette name='Game Platforms' type='regular'><color>#FF8C42</color><color>#9B59B6</color><color>#8FB3FF</color><color>#D4AF37</color><color>#2E6FDB</color><color>#9A8F78</color><color>#E52521</color><color>#52B043</color></color-palette>
</preferences>
<style />
<datasources>
<datasource caption='vgsales_tableau' inline='true' name='federated.vgsales0' version='18.1'>
  <connection class='federated'>
    <named-connections>
      <named-connection caption='vgsales_tableau' name='textscan.vgsales0'>
        <connection class='textscan' directory='C:/Users/ual-laptop/Documents/Claude Work/video-game-sales-analytics/tableau' filename='vgsales_tableau.csv' password='' server='' />
      </named-connection>
    </named-connections>
    <relation connection='textscan.vgsales0' name='vgsales_tableau.csv' table='[vgsales_tableau#csv]' type='table'>
      <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
<column datatype='string' name='Game' ordinal='0' />
<column datatype='string' name='Platform' ordinal='1' />
<column datatype='string' name='Genre' ordinal='2' />
<column datatype='string' name='Publisher' ordinal='3' />
<column datatype='integer' name='Year' ordinal='4' />
<column datatype='string' name='Decade' ordinal='5' />
<column datatype='string' name='Region' ordinal='6' />
<column datatype='real' name='Sales (M units)' ordinal='7' />
      </columns>
    </relation>
  </connection>
<column datatype='string' name='[Game]' role='dimension' type='nominal' />
<column datatype='string' name='[Platform]' role='dimension' type='nominal' />
<column datatype='string' name='[Genre]' role='dimension' type='nominal' />
<column datatype='string' name='[Publisher]' role='dimension' type='nominal'><aliases><alias key='&quot;Sony Computer Entertainment&quot;' value='Sony' /><alias key='&quot;Take-Two Interactive&quot;' value='Take-Two' /><alias key='&quot;Konami Digital Entertainment&quot;' value='Konami' /><alias key='&quot;Namco Bandai Games&quot;' value='Bandai Namco' /></aliases></column>
<column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
<column datatype='string' name='[Decade]' role='dimension' type='nominal' />
<column datatype='string' name='[Region]' role='dimension' type='nominal'><aliases><alias key='&quot;North America&quot;' value='N. America' /><alias key='&quot;Rest of World&quot;' value='Other' /></aliases></column>
<column datatype='real' name='[Sales (M units)]' role='measure' type='quantitative' />
  <extract count='-1' enabled='true' units='records'>
    <connection access_mode='readonly' author-locale='en_US' authentication='auth-none' class='hyper' dbname='C:/Users/ual-laptop/Documents/Claude Work/video-game-sales-analytics/tableau/vgsales_tableau.hyper' default-settings='yes' schema='Extract' sslmode='' tablename='Extract' username='tableau_internal_user'>
      <relation name='Extract' table='[Extract].[Extract]' type='table' />
    </connection>
  </extract>
  <style>
    <style-rule element='mark'>
      <encoding attr='color' field='[none:Region:nk]' type='palette'><map to='#E52521'><bucket>&quot;North America&quot;</bucket></map><map to='#2E6FDB'><bucket>&quot;Europe&quot;</bucket></map><map to='#FFCB05'><bucket>&quot;Japan&quot;</bucket></map><map to='#3FA34D'><bucket>&quot;Rest of World&quot;</bucket></map></encoding>
      <encoding attr='color' field='[none:Platform:nk]' type='palette'><map to='#D4AF37'><bucket>&quot;PS2&quot;</bucket></map><map to='#52B043'><bucket>&quot;X360&quot;</bucket></map><map to='#2E6FDB'><bucket>&quot;PS3&quot;</bucket></map><map to='#E52521'><bucket>&quot;Wii&quot;</bucket></map><map to='#FF8C42'><bucket>&quot;DS&quot;</bucket></map><map to='#8FB3FF'><bucket>&quot;PS&quot;</bucket></map><map to='#9B59B6'><bucket>&quot;GBA&quot;</bucket></map><map to='#9A8F78'><bucket>&quot;PSP&quot;</bucket></map></encoding>
    </style-rule>
  </style>
</datasource>
</datasources>
<actions><action caption='Click a genre to filter' name='[Action1_genre]'><activation auto-clear='true' type='on-select' /><source dashboard='Video Game Sales 1980-2016' type='sheet' worksheet='Regional Mix' /><command command='tsc:tsl-filter'><param name='special-fields' value='all' /><param name='target' value='Video Game Sales 1980-2016' /></command></action></actions>
<worksheets>
<worksheet name='Market Over Time'>
  <layout-options><title><formatted-text><run bold='true' fontcolor='#D4AF37' fontname='Tableau Bold' fontsize='14'>WORLD 1-1 TO 2016</run><run>Æ&#10;</run><run fontcolor='#9A8F78' fontname='Tableau Book' fontsize='9'>Tracked retail units per year (millions), stacked by region. The high score was set in 2008.</run></formatted-text></title></layout-options>
  <table>
    <view>
      <datasources><datasource caption='vgsales_tableau' name='federated.vgsales0' /></datasources>
      <datasource-dependencies datasource='federated.vgsales0'>
<column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
<column-instance column='[Year]' derivation='None' name='[none:Year:qk]' pivot='key' type='quantitative' />
<column datatype='real' name='[Sales (M units)]' role='measure' type='quantitative' />
<column-instance column='[Sales (M units)]' derivation='Sum' name='[sum:Sales (M units):qk]' pivot='key' type='quantitative' />
<column datatype='string' name='[Region]' role='dimension' type='nominal'><aliases><alias key='&quot;North America&quot;' value='N. America' /><alias key='&quot;Rest of World&quot;' value='Other' /></aliases></column>
<column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
<column datatype='string' name='[Decade]' role='dimension' type='nominal' />
<column-instance column='[Decade]' derivation='None' name='[none:Decade:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
      
      <filter class='categorical' column='[federated.vgsales0].[none:Region:nk]' filter-group='1'><groupfilter function='level-members' level='[none:Region:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
      <filter class='categorical' column='[federated.vgsales0].[none:Decade:nk]' filter-group='2'><groupfilter function='level-members' level='[none:Decade:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
      
      <slices><column>[federated.vgsales0].[none:Region:nk]</column><column>[federated.vgsales0].[none:Decade:nk]</column></slices>
      <aggregation value='true' />
    </view>
    <style>
  <style-rule element='worksheet'><format attr='display-field-labels' scope='cols' value='false' /><format attr='display-field-labels' scope='rows' value='false' /><format attr='font-family' value='Tableau Book' /><format attr='color' value='#E8DFC8' /><format attr='background-color' value='#201C16' /></style-rule>
  <style-rule element='table'><format attr='background-color' value='#201C16' /></style-rule>
  <style-rule element='title'><format attr='background-color' value='#201C16' /></style-rule>
  <style-rule element='axis'><format attr='color' value='#9A8F78' /><format attr='font-size' value='8' /></style-rule>
  <style-rule element='header'><format attr='color' value='#E8DFC8' /><format attr='font-size' value='9' /></style-rule>
  <style-rule element='label'><format attr='color' value='#E8DFC8' /><format attr='font-size' value='9' /></style-rule>
  <style-rule element='cell'><format attr='color' value='#E8DFC8' /></style-rule>
  <style-rule element='gridline'><format attr='line-visibility' value='off' /></style-rule>
  <style-rule element='zeroline'><format attr='line-visibility' value='off' /></style-rule>
  <style-rule element='mark'><encoding attr='color' field='[federated.vgsales0].[none:Region:nk]' palette='Game Regions' type='palette' /><encoding attr='color' field='[federated.vgsales0].[none:Platform:nk]' palette='Game Platforms' type='palette' /></style-rule>
  
</style>
    <panes>
      <pane selection-relaxation-option='selection-relaxation-allow'>
        <view><breakdown value='auto' /></view>
        <mark class='Area' />
        <encodings><color column='[federated.vgsales0].[none:Region:nk]' /></encodings>
        <style><style-rule element='mark'></style-rule></style>
      </pane>
    </panes>
    <rows>[federated.vgsales0].[sum:Sales (M units):qk]</rows>
    <cols>[federated.vgsales0].[none:Year:qk]</cols>
  </table>
</worksheet>
<worksheet name='Regional Mix'>
  <layout-options><title><formatted-text><run bold='true' fontcolor='#D4AF37' fontname='Tableau Bold' fontsize='14'>CHOOSE YOUR KINGDOM</run><run>Æ&#10;</run><run fontcolor='#9A8F78' fontname='Tableau Book' fontsize='9'>Share of each region&#x27;s units by genre. Click a square to filter the dashboard.</run></formatted-text></title></layout-options>
  <table>
    <view>
      <datasources><datasource caption='vgsales_tableau' name='federated.vgsales0' /></datasources>
      <datasource-dependencies datasource='federated.vgsales0'>
<column datatype='string' name='[Genre]' role='dimension' type='nominal' />
<column-instance column='[Genre]' derivation='None' name='[none:Genre:nk]' pivot='key' type='nominal' />
<column datatype='real' name='[Sales (M units)]' role='measure' type='quantitative' />
<column-instance column='[Sales (M units)]' derivation='Sum' name='[pcto:sum:Sales (M units):qk]' pivot='key' type='quantitative'><table-calc ordering-field='[federated.vgsales0].[none:Genre:nk]' ordering-type='Field' type='PctTotal' /></column-instance>
<column-instance column='[Sales (M units)]' derivation='Sum' name='[sum:Sales (M units):qk]' pivot='key' type='quantitative' />
<column datatype='string' name='[Region]' role='dimension' type='nominal'><aliases><alias key='&quot;North America&quot;' value='N. America' /><alias key='&quot;Rest of World&quot;' value='Other' /></aliases></column>
<column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
<column datatype='string' name='[Decade]' role='dimension' type='nominal' />
<column-instance column='[Decade]' derivation='None' name='[none:Decade:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
      
      <filter class='categorical' column='[federated.vgsales0].[none:Region:nk]' filter-group='1'><groupfilter function='level-members' level='[none:Region:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
      <filter class='categorical' column='[federated.vgsales0].[none:Decade:nk]' filter-group='2'><groupfilter function='level-members' level='[none:Decade:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
      <sort class='computed' column='[federated.vgsales0].[none:Genre:nk]' direction='DESC' using='[federated.vgsales0].[sum:Sales (M units):qk]' />
      <slices><column>[federated.vgsales0].[none:Region:nk]</column><column>[federated.vgsales0].[none:Decade:nk]</column></slices>
      <aggregation value='true' />
    </view>
    <style>
  <style-rule element='worksheet'><format attr='display-field-labels' scope='cols' value='false' /><format attr='display-field-labels' scope='rows' value='false' /><format attr='font-family' value='Tableau Book' /><format attr='color' value='#E8DFC8' /><format attr='background-color' value='#201C16' /></style-rule>
  <style-rule element='table'><format attr='background-color' value='#201C16' /></style-rule>
  <style-rule element='title'><format attr='background-color' value='#201C16' /></style-rule>
  <style-rule element='axis'><format attr='color' value='#9A8F78' /><format attr='font-size' value='8' /></style-rule>
  <style-rule element='header'><format attr='color' value='#E8DFC8' /><format attr='font-size' value='9' /></style-rule>
  <style-rule element='label'><format attr='color' value='#E8DFC8' /><format attr='font-size' value='9' /></style-rule>
  <style-rule element='cell'><format attr='color' value='#E8DFC8' /></style-rule>
  <style-rule element='gridline'><format attr='line-visibility' value='off' /></style-rule>
  <style-rule element='zeroline'><format attr='line-visibility' value='off' /></style-rule>
  <style-rule element='mark'><encoding attr='color' field='[federated.vgsales0].[none:Region:nk]' palette='Game Regions' type='palette' /><encoding attr='color' field='[federated.vgsales0].[none:Platform:nk]' palette='Game Platforms' type='palette' /></style-rule>
  <style-rule element='cell'><format attr='text-format' field='[federated.vgsales0].[pcto:sum:Sales (M units):qk]' value='p0%' /></style-rule><style-rule element='mark'><encoding attr='color' field='[federated.vgsales0].[pcto:sum:Sales (M units):qk]' palette='Lands Between Gold' type='interpolated' /></style-rule>
</style>
    <panes>
      <pane selection-relaxation-option='selection-relaxation-allow'>
        <view><breakdown value='auto' /></view>
        <mark class='Square' />
        <encodings><color column='[federated.vgsales0].[pcto:sum:Sales (M units):qk]' /><text column='[federated.vgsales0].[pcto:sum:Sales (M units):qk]' /></encodings>
        <style><style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule></style>
      </pane>
    </panes>
    <rows>[federated.vgsales0].[none:Genre:nk]</rows>
    <cols>[federated.vgsales0].[none:Region:nk]</cols>
  </table>
</worksheet>
<worksheet name='Platform Lifecycles'>
  <layout-options><title><formatted-text><run bold='true' fontcolor='#D4AF37' fontname='Tableau Bold' fontsize='14'>EXTRA LIVES</run><run>Æ&#10;</run><run fontcolor='#9A8F78' fontname='Tableau Book' fontsize='9'>Units per year, 8 best-selling platforms since 1994. Every console gets a launch, a peak, and a game over.</run></formatted-text></title></layout-options>
  <table>
    <view>
      <datasources><datasource caption='vgsales_tableau' name='federated.vgsales0' /></datasources>
      <datasource-dependencies datasource='federated.vgsales0'>
<column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
<column-instance column='[Year]' derivation='None' name='[none:Year:qk]' pivot='key' type='quantitative' />
<column datatype='string' name='[Platform]' role='dimension' type='nominal' />
<column-instance column='[Platform]' derivation='None' name='[none:Platform:nk]' pivot='key' type='nominal' />
<column datatype='real' name='[Sales (M units)]' role='measure' type='quantitative' />
<column-instance column='[Sales (M units)]' derivation='Sum' name='[sum:Sales (M units):qk]' pivot='key' type='quantitative' />
<column datatype='string' name='[Region]' role='dimension' type='nominal'><aliases><alias key='&quot;North America&quot;' value='N. America' /><alias key='&quot;Rest of World&quot;' value='Other' /></aliases></column>
<column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
<column datatype='string' name='[Decade]' role='dimension' type='nominal' />
<column-instance column='[Decade]' derivation='None' name='[none:Decade:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
      <filter class='categorical' column='[federated.vgsales0].[none:Platform:nk]'><groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'><groupfilter function='member' level='[none:Platform:nk]' member='&quot;PS2&quot;' /><groupfilter function='member' level='[none:Platform:nk]' member='&quot;X360&quot;' /><groupfilter function='member' level='[none:Platform:nk]' member='&quot;PS3&quot;' /><groupfilter function='member' level='[none:Platform:nk]' member='&quot;Wii&quot;' /><groupfilter function='member' level='[none:Platform:nk]' member='&quot;DS&quot;' /><groupfilter function='member' level='[none:Platform:nk]' member='&quot;PS&quot;' /><groupfilter function='member' level='[none:Platform:nk]' member='&quot;GBA&quot;' /><groupfilter function='member' level='[none:Platform:nk]' member='&quot;PSP&quot;' /></groupfilter></filter><filter class='quantitative' column='[federated.vgsales0].[none:Year:qk]' included-values='in-range'><min>1994</min></filter>
      <filter class='categorical' column='[federated.vgsales0].[none:Region:nk]' filter-group='1'><groupfilter function='level-members' level='[none:Region:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
      <filter class='categorical' column='[federated.vgsales0].[none:Decade:nk]' filter-group='2'><groupfilter function='level-members' level='[none:Decade:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
      
      <slices><column>[federated.vgsales0].[none:Region:nk]</column><column>[federated.vgsales0].[none:Decade:nk]</column></slices>
      <aggregation value='true' />
    </view>
    <style>
  <style-rule element='worksheet'><format attr='display-field-labels' scope='cols' value='false' /><format attr='display-field-labels' scope='rows' value='false' /><format attr='font-family' value='Tableau Book' /><format attr='color' value='#E8DFC8' /><format attr='background-color' value='#201C16' /></style-rule>
