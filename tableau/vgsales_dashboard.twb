    <rows>[federated.vgsales0].[sum:Sales (M units):qk]</rows>
    <cols>[federated.vgsales0].[none:Year:qk]</cols>
  </table>
</worksheet>
<worksheet name='Top Publishers'>
  <layout-options><title><formatted-text><run bold='true' fontcolor='#D4AF37' fontname='Tableau Bold' fontsize='14'>FINAL BOSSES</run><run>Æ&#10;</run><run fontcolor='#9A8F78' fontname='Tableau Book' fontsize='9'>Top 10 publishers by lifetime units (millions).</run></formatted-text></title></layout-options>
  <table>
    <view>
      <datasources><datasource caption='vgsales_tableau' name='federated.vgsales0' /></datasources>
