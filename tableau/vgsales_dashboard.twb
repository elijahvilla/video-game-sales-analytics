<dashboard name='Video Game Sales 1980-2016'>
  <style><style-rule element='table'><format attr='background-color' value='#16130F' /></style-rule></style>
  <size maxheight='1720' maxwidth='1200' minheight='1720' minwidth='1200' />
  <zones><zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'><zone id='11' is-scaled='1' param='C:/Users/ual-laptop/Documents/Claude Work/video-game-sales-analytics/tableau/assets/header.png' type-v2='bitmap' x='0' y='0' w='100000' h='11628'><zone-style><format attr='background-color' value='#16130F' /><format attr='margin' value='0' /><format attr='padding' value='0' /></zone-style></zone><zone id='12' type-v2='text' x='1667' y='12209' w='23333' h='9302'><formatted-text><run bold='true' fontcolor='#D4AF37' fontname='Tableau Bold' fontsize='9'>WORLD RECORD</run><run>Æ&#10;</run><run bold='true' fontcolor='#E8DFC8' fontname='Tableau Bold' fontsize='22'>82.7M</run><run>Æ&#10;</run><run fontcolor='#9A8F78' fontname='Tableau Book' fontsize='9'>Wii Sports, best-selling title</run></formatted-text><zone-style><format attr='background-color' value='#201C16' /><format attr='border-color' value='#3A3226' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='padding' value='8' /></zone-style></zone><zone id='13' type-v2='text' x='25833' y='12209' w='23333' h='9302'><formatted-text><run bold='true' fontcolor='#D4AF37' fontname='Tableau Bold' fontsize='9'>FINAL BOSS PLATFORM</run><run>Æ&#10;</run><run bold='true' fontcolor='#E8DFC8' fontname='Tableau Bold' fontsize='22'>1.23B</run><run>Æ&#10;</run><run fontcolor='#9A8F78' fontname='Tableau Book' fontsize='9'>PS2 lifetime units</run></formatted-text><zone-style><format attr='background-color' value='#201C16' /><format attr='border-color' value='#3A3226' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='padding' value='8' /></zone-style></zone><zone id='14' type-v2='text' x='50000' y='12209' w='23333' h='9302'><formatted-text><run bold='true' fontcolor='#D4AF37' fontname='Tableau Bold' fontsize='9'>HOME-FIELD ADVANTAGE</run><run>Æ&#10;</run><run bold='true' fontcolor='#E8DFC8' fontname='Tableau Bold' fontsize='22'>35.5%</run><run>Æ&#10;</run><run fontcolor='#9A8F78' fontname='Tableau Book' fontsize='9'>Nintendo&#x27;s share of Japan</run></formatted-text><zone-style><format attr='background-color' value='#201C16' /><format attr='border-color' value='#3A3226' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='padding' value='8' /></zone-style></zone><zone id='15' mode='checkdropdown' name='Market Over Time' param='[federated.vgsales0].[none:Region:nk]' type-v2='filter' values='database' x='74167' y='12209' w='24167' h='4535'><zone-style><format attr='background-color' value='#201C16' /><format attr='border-color' value='#3A3226' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='4' /><format attr='padding' value='2' /></zone-style></zone><zone id='16' mode='checkdropdown' name='Market Over Time' param='[federated.vgsales0].[none:Decade:nk]' type-v2='filter' values='database' x='74167' y='16977' w='24167' h='4535'><zone-style><format attr='background-color' value='#201C16' /><format attr='border-color' value='#3A3226' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='4' /><format attr='padding' value='2' /></zone-style></zone><zone id='17' name='Market Over Time' x='1667' y='22093' w='82500' h='21512'><zone-style><format attr='background-color' value='#201C16' /><format attr='border-color' value='#3A3226' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='padding' value='8' /></zone-style></zone><zone id='18' name='Market Over Time' pane-specification-id='0' param='[federated.vgsales0].[none:Region:nk]' type-v2='color' x='85000' y='22093' w='13333' h='21512'><zone-style><format attr='background-color' value='#201C16' /><format attr='border-color' value='#3A3226' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='padding' value='8' /></zone-style></zone><zone id='19' name='Regional Mix' x='1667' y='44186' w='45000' h='25000'><zone-style><format attr='background-color' value='#201C16' /><format attr='border-color' value='#3A3226' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='padding' value='8' /></zone-style></zone><zone id='20' name='Platform Lifecycles' x='47500' y='44186' w='39167' h='25000'><zone-style><format attr='background-color' value='#201C16' /><format attr='border-color' value='#3A3226' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='padding' value='8' /></zone-style></zone><zone id='21' name='Platform Lifecycles' pane-specification-id='0' param='[federated.vgsales0].[none:Platform:nk]' type-v2='color' x='87500' y='44186' w='10833' h='25000'><zone-style><format attr='background-color' value='#201C16' /><format attr='border-color' value='#3A3226' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='padding' value='8' /></zone-style></zone><zone id='22' name='Top Publishers' x='1667' y='69767' w='51667' h='24419'><zone-style><format attr='background-color' value='#201C16' /><format attr='border-color' value='#3A3226' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='padding' value='8' /></zone-style></zone><zone id='23' type-v2='text' x='54167' y='69767' w='44167' h='24419'><formatted-text><run bold='true' fontcolor='#D4AF37' fontname='Tableau Bold' fontsize='14'>INSIGHT AHEAD</run><run>Æ&#10;</run><run fontcolor='#9A8F78' fontname='Tableau Book' fontsize='9'>Messages left for the next player</run><run>Æ&#10;</run><run>Æ&#10;</run><run bold='true' fontcolor='#D4AF37' fontname='Tableau Bold' fontsize='10'>Japan ahead, therefore role-playing.</run><run>Æ&#10;</run><run fontcolor='#E8DFC8' fontname='Tableau Book' fontsize='9'>RPGs take 3.6x the share of units in Japan that they do in North America.</run><run>Æ&#10;</run><run>Æ&#10;</run><run bold='true' fontcolor='#D4AF37' fontname='Tableau Bold' fontsize='10'>Strong foe ahead: Nintendo.</run><run>Æ&#10;</run><run fontcolor='#E8DFC8' fontname='Tableau Book' fontsize='9'>#1 publisher in North America (19%), Europe (17%), and Japan (36%).</run><run>Æ&#10;</run><run>Æ&#10;</run><run bold='true' fontcolor='#D4AF37' fontname='Tableau Bold' fontsize='10'>Praise the PS2.</run><run>Æ&#10;</run><run fontcolor='#E8DFC8' fontname='Tableau Book' fontsize='9'>1.23 billion units, the best-selling platform in the data. Its peak year was 2004.</run></formatted-text><zone-style><format attr='background-color' value='#201C16' /><format attr='border-color' value='#3A3226' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='6' /><format attr='padding' value='8' /></zone-style></zone><zone id='24' type-v2='text' x='1667' y='94767' w='96667' h='4942'><formatted-text><run bold='true' fontcolor='#D4AF37' fontname='Tableau Bold' fontsize='8'>DATA </run><run fontcolor='#9A8F78' fontname='Tableau Book' fontsize='8'>VGChartz via Kaggle (CC0), 16,187 titles, 1980-2016. Physical retail units only, so digital sales and recent years are undercounted.</run><run>Æ&#10;</run><run bold='true' fontcolor='#D4AF37' fontname='Tableau Bold' fontsize='8'>BUILT BY </run><run fontcolor='#9A8F78' fontname='Tableau Book' fontsize='8'>Elijah Villa  |  github.com/elijahvilla/video-game-sales-analytics</run></formatted-text><zone-style><format attr='background-color' value='#16130F' /><format attr='margin' value='6' /><format attr='padding' value='8' /></zone-style></zone></zone></zones>
</dashboard>
